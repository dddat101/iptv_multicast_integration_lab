# ==============================================================================
# REAL IPTV MULTICAST TEST LAB - CONFIGURATION
# Copy to config.env and customize for your local setup.
# ==============================================================================

# Operating mode:
#   0 = Physical DUT mode (requires dedicated USB Ethernet adapters)
#   1 = Virtual simulation mode (bridges namespaces via virtual router ns-dut)
IS_VIRTUAL="0"

# Server-only deployment:
#   0 = Deploy server and STB client namespaces [Default]
#   1 = Deploy Media Server only and start streaming (skip client namespaces)
SERVER_ONLY="0"

# Dedicated physical Ethernet adapter(s) connected to the DUT:
# WAN_IF connects to DUT WAN port; LAN_IF connects to DUT LAN port.
# WARNING: These MUST NOT carry the host default route or management traffic!
WAN_IF="enx00e04c360001"
LAN_IF="enx00e04c360002"

# Restore physical interfaces on cleanup:
#   1 = Restore physical interfaces (WAN_IF, LAN_IF) to UP, managed by NetworkManager, and trigger DHCP [Default]
#   0 = Keep physical interfaces DOWN and flushed (isolated test mode)
RESTORE_INTERFACES_ON_CLEANUP="1"

# Expected DUT addressing for packet routing and validation.
DUT_WAN_IP="10.10.0.1"
DUT_LAN_IP="10.20.0.1"

# Explicit host-side test bridges (used for L2 fan-out to namespaces).
WAN_BRIDGE="br-test-wan"
LAN_BRIDGE="br-test-lan"

# WAN control-plane namespace (runs optional querier and upstream WAN DHCP server).
WAN_NS="ns-wan"
WAN_NS_IP="10.10.0.254/24"
WAN_NS_GW="10.10.0.1"

# Upstream WAN DHCP Server settings (runs inside ns-wan to allocate IP to DUT WAN)
ENABLE_WAN_DHCP="1"
WAN_DHCP_START="10.10.0.1"
WAN_DHCP_END="10.10.0.50"
WAN_DHCP_LEASE="12h"
DUT_WAN_MAC=""

# Media assets.
MEDIA_FILE="sample_1080p_8mbps.ts"
MEDIA_DIR="./media"

# Multicast MPEG-TS stream parameters.
MCAST_GROUP="239.10.10.10"
MCAST_PORT="5000"
MCAST_TTL="16"
MPEGTS_PKT_SIZE="1316"
STREAM_BITRATE="8M"

# Media Server namespace (FFmpeg MPEG-TS transmitter).
SERVER_NAME="ns-server"
SERVER_IP="10.10.0.2/24"
SERVER_GW="10.10.0.1"

# STB Client Scaling & Emulation:
# Number of STB client namespaces to emulate (e.g. 2, 5, 10, 20)
CLIENT_COUNT="5"
CLIENT_PREFIX="ns-stb"
CLIENT_HOSTNAME_PREFIX="stb"

# Client 1 namespace (VLC receiver / STB emulator 1).
CLIENT1_NAME="ns-stb1"
CLIENT1_IP="10.20.0.11/24"
CLIENT1_GW="10.20.0.1"
CLIENT1_HOSTNAME="stb-living-room"

# Client 2 namespace (VLC receiver / STB emulator 2).
CLIENT2_NAME="ns-stb2"
CLIENT2_IP="10.20.0.12/24"
CLIENT2_GW="10.20.0.1"
CLIENT2_HOSTNAME="stb-bedroom"

# Client addressing mode:
#   "dhcp"   = Clients request IP from DUT LAN DHCP server (e.g. 192.168.1.x) [Default]
#   "static" = Clients use statically configured IP addresses below
CLIENT_IP_MODE="dhcp"

# Client identification options for DHCP / IGMP.
CLIENT_DHCP_VENDOR="IPTV_STB"
FORCE_IGMP_VERSION="2"

# Optional WAN IGMP Querier settings.
ENABLE_WAN_QUERIER="0"
PIMD_CONFIG="./config/pimd.conf"

# Runtime directories.
CAPTURE_DIR="captures"
LOG_DIR="logs"
STATE_DIR="state"

# BPF capture filter for tcpdump / tshark.
CAPTURE_FILTER="igmp or (udp and port 5000)"

# ==============================================================================
# MULTICAST BENCHMARK & RFC VERIFICATION SUITE PARAMETERS
# ==============================================================================

# Remote DUT Management (SSH credentials for diagnostic collection)
DUT_SSH_HOST="192.168.1.1"
DUT_SSH_USER="admin"
DUT_SSH_PASS="admin"
DUT_SSH_PORT="22"

# Multicast Group Capacity Scale Test
SCALE_GROUP_PREFIX="239.100.1"
SCALE_GROUP_COUNT="32"
SCALE_HOLD_SEC="15"

# Rapid Join/Leave Churn Stress Test
CHURN_INTERVAL_MS="100"
CHURN_CYCLES="30"

# High-Rate Group-Specific Query Stress Test
QUERY_STRESS_RATE="250"
QUERY_STRESS_DURATION="10"

# Multi-Group Packet Loss Measurement
LOSS_TEST_GROUPS="12"
LOSS_TEST_PACKET_SIZE="1200"
LOSS_TEST_RATE_PPS="1200"
LOSS_TEST_DURATION="15"

# Foreign LAN Querier Election Test
FOREIGN_QUERIER_IP="192.168.1.250"

