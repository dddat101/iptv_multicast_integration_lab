FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        iproute2 \
        iputils-ping \
        procps \
        vlc \
    && rm -rf /var/lib/apt/lists/* \
    && (userdel -r ubuntu 2>/dev/null || true) \
    && useradd --create-home --uid 1000 media

WORKDIR /media
USER media
ENTRYPOINT ["/bin/bash"]
